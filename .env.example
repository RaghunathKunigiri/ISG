# Project & Employee Progress Tracking System
# Environment Configuration

# Application
APP_ENV=development
APP_NAME="ISG Progress & Performance Tracker"
SECRET_KEY=change-this-super-secret-key-in-production-min-32-chars-long
API_V1_STR=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Security & Token Lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
LOCKOUT_THRESHOLD=5
LOCKOUT_WINDOW_MINUTES=15
LOCKOUT_DURATION_MINUTES=30

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/isg_tracker
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/isg_tracker
TEST_DATABASE_URL=sqlite+aiosqlite:///./test.db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Email & Notifications (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
EMAILS_FROM_EMAIL=notifications@isg-tracker.local
EMAILS_FROM_NAME="ISG System"

# S3 / Object Store (MinIO / AWS)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=tracker-attachments
S3_REGION=us-east-1

# OIDC / SSO Integration (Optional)
OIDC_ENABLED=false
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISCOVERY_URL=

